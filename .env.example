# ---------------------------------------------------------------------------
# Admin account.
#
# SECURITY: anything set here is INLINED INTO THE JAVASCRIPT BUNDLE and is
# readable by anyone who opens the application. Do not put a real password here
# for a production terminal.
#
# Leave VITE_ADMIN_PASSWORD unset (the default). On first run the application
# generates a random one-time setup password, displays it on the sign-in
# screen, and requires it to be changed before the till can be used. No secret
# is embedded in the build.
#
# Set VITE_ADMIN_PASSWORD only for automated testing, or for kiosk
# provisioning where the password is changed immediately afterwards.
# ---------------------------------------------------------------------------

VITE_ADMIN_USERNAME=admin
# VITE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Automated-test bridge (development only).
#
# When 'true', the app exposes its services on window.__pos so end-to-end
# tests can seed fixtures and assert persisted state. Leave unset/false for
# any real build; it is off by default.
# ---------------------------------------------------------------------------

# VITE_EXPOSE_TEST_API=false

# ---------------------------------------------------------------------------
# Sync backend (optional).
#
# When set, local changes are uploaded in the background once online. When
# unset, the app is purely local - changes still queue durably, so enabling a
# backend later uploads everything recorded in the meantime.
# See src/services/sync/README.md for the contract.
# ---------------------------------------------------------------------------

# VITE_SYNC_API_URL=https://api.example.com/pos

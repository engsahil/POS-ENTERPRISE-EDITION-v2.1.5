    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "fake-indexeddb": "6.2.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }

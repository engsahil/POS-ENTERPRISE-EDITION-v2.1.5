{
  "name": "pos-app",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "description": "Offline-first Point of Sale application",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
